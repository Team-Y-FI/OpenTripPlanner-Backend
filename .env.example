APP_NAME=OpenTripPlanner API
ENV=dev
SECRET_KEY=CHANGE_ME_TO_SOMETHING_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

