APP_NAME=OpenTripPlanner API
ENV=dev
SECRET_KEY=CHANGE_ME_TO_SOMETHING_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR_DB_HOST:5432/opentripplanner

CORS_ORIGINS=http://localhost:3000,http://localhost:19006

STORAGE_BACKEND=local
STORAGE_DIR=/app/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_KEY_PREFIX=uploads
S3_PUBLIC_BASE_URL=
S3_USE_PRESIGNED_URL=true
S3_PRESIGNED_URL_EXPIRES=3600

UPLOAD_MAX_PHOTOS=20
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_EXTS=jpg,jpeg,png,webp,heic,heif

REDIS_URL=redis://redis:6379/0

GOOGLE_API_KEY=
